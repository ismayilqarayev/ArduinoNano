{
    "env": {
        "arduinoAvr": "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.8",
        "avrGcc": "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7"
    },
    "configurations": [
        {
            "name": "Arduino Nano",
            "compilerPath": "${avrGcc}/bin/avr-g++.exe",
            "compilerArgs": [
                "-mmcu=atmega328p",
                "-std=gnu++11"
            ],
            "includePath": [
                "${workspaceFolder}/**",
                "${arduinoAvr}/cores/arduino",
                "${arduinoAvr}/variants/eightanaloginputs",
                "${arduinoAvr}/libraries/**",
                "${avrGcc}/avr/include"
            ],
            "forcedInclude": [
                "${arduinoAvr}/cores/arduino/Arduino.h"
            ],
            "defines": [
                "F_CPU=16000000L",
                "ARDUINO=10607",
                "ARDUINO_AVR_NANO",
                "ARDUINO_ARCH_AVR",
                "__AVR_ATmega328P__"
            ],
            "cStandard": "gnu11",
            "cppStandard": "gnu++11",
            "intelliSenseMode": "gcc-x86"
        }
    ],
    "version": 4
}
